# =============================================================================
# SUSE Demo AWS - Unified Configuration File
# =============================================================================
# This single terraform.tfvars file contains configuration for all modules:
#   - shared-services/
#   - rancher-manager/
#   - observability/
#   - security/
#
# Usage: Each module should reference this file via:
#   terraform apply -var-file=../terraform.tfvars
# =============================================================================

# Update this var to indicate this file has been modified - else democtl will
#   halt.  (future use)
tf_updated = "false"

# -----------------------------------------------------------------------------
# Module Deploy Toggles (read by Scripts/democtl build)
# -----------------------------------------------------------------------------
# shared-services (core networking/VPC) is always deployed - it has no toggle.
# Set any of the following to false to skip that module during `democtl build`.
rancher_deploy        = true ## REVIEW ##
observability_deploy  = true ## REVIEW ##
security_deploy       = true ## REVIEW ##

# -----------------------------------------------------------------------------
# Global Configuration
# -----------------------------------------------------------------------------
aws_region  = "us-east-2" 
environment = "suse-demo-aws" ## UPDATE ##
owner       = "your-name" ## UPDATE ##

# -----------------------------------------------------------------------------
# Network Configuration (shared-services module)
# -----------------------------------------------------------------------------
vpc_cidr           = "10.0.0.0/16" 
availability_zones = ["us-east-2a"]
az_count           = 1
enable_nat_gateway = false

# -----------------------------------------------------------------------------
# Security Configuration (all modules)
# -----------------------------------------------------------------------------
# IMPORTANT: Restrict these to your IP address for better security
allowed_ssh_cidr_blocks = ["0.0.0.0/0"]
allowed_web_cidr_blocks = ["0.0.0.0/0"]
allowed_cidr_blocks     = ["0.0.0.0/0"]

# -----------------------------------------------------------------------------
# SSH Configuration (all product modules)
# -----------------------------------------------------------------------------
# Paste your SSH public key here
ssh_public_key = ""

# you should run: export DOMAIN=suse-aws-hybrid-lab # example value there
#  [ ! -f ~/.ssh/$DOMAIN.pem ] && { aws ec2 create-key-pair --key-name $DOMAIN --region us-east-2 --query "KeyMaterial" --output text > ~/.ssh/$DOMAIN.pem; chmod 0600 ~/.ssh/$DOMAIN.pem; }
#  aws ec2 describe-key-pairs --region us-east-2  --key-name $DOMAIN --include-public-key --query "KeyPairs[0].PublicKey" --output text
# You can also use the following to gather your pub.key
#  ssh-keygen -y -f ~/.ssh/$DOMAIN.pem > ~/.ssh/$DOMAIN.pub; cat ~/.ssh/$DOMAIN.pub
# NOTE:  the terraform apply will create suse-demo-aws-rancher-key also
#  ssh -i ~/.ssh/$DOMAIN.pem ec2-user@rancher.$DOMAIN.kubernerdes.com
#  aws ec2 import-key-pair --key-name $DOMAIN --public-key-material fileb://~/.ssh/$DOMAIN.pub
# **********************************************************************

# -----------------------------------------------------------------------------
# EC2 Instance Configuration (per module)
# -----------------------------------------------------------------------------
# SUSE Rancher Manager
rancher_instance_type      = "t3.large" # Testing this size (2025-10-18)
rancher_root_volume_size   = 100

# SUSE Observability (StackState)
observability_instance_type     = "t3.2xlarge"  # Minimum for 10-nonha profile
observability_root_volume_size  = 300          # Minimum 280GB for 10-nonha profile

# SUSE Security (NeuVector)
security_instance_type      = "t3.large"
security_root_volume_size   = 100

# -----------------------------------------------------------------------------
# Elastic IP Configuration (all product modules)
# -----------------------------------------------------------------------------
create_eip = true

# -----------------------------------------------------------------------------
# DNS Configuration (Route53 - optional)
# -----------------------------------------------------------------------------
create_route53_record = true 
root_domain           = "kubernerdes.com" ## UPDATE ##
subdomain             = "suse-demo-aws" ## UPDATE ##
route53_zone_id       = ""  # Leave empty to auto-discover 
                            # either format: /hostedzone/Z00000000001 or Z00000000001 should be acceptable
# To find your Route53 zone ID:
# aws route53 list-hosted-zones-by-name --dns-name $DOMAIN.kubernerdes.com --query "HostedZones[].Id" --output text

# DNS Hostnames (per product)
hostname_rancher       = "rancher"
hostname_observability = "observability"
hostname_security      = "security"

# -----------------------------------------------------------------------------
# Let's Encrypt Configuration (all product modules)
# -----------------------------------------------------------------------------
# Enable automatic TLS certificate provisioning via Let's Encrypt
# Requires: create_route53_record = true and valid letsencrypt_email
enable_letsencrypt      = true 
letsencrypt_email       = "your-email@example.com"
letsencrypt_environment = "production"  # Use "staging" for testing, "production" for real certs
                                        # I tend to use production as staging introduces odd issues and errors

# NOTE: Let's Encrypt uses Route53 DNS-01 challenge for certificate validation
# - Staging environment: Higher rate limits, issues test certificates (use for testing)
# - Production environment: Lower rate limits, issues trusted certificates (use when ready)
# - Switch from staging to production after confirming everything works

# -----------------------------------------------------------------------------
# SUSE Registration (all modules)
# -----------------------------------------------------------------------------
# IMPORTANT: Update these with your SUSE subscription details
suse_email   = "your-email@example.com"
suse_regcode = "YOUR-REGISTRATION-CODE-HERE"
smt_url      = ""  # Optional: SMT/RMT server URL (leave empty to use SCC)
             # "https://rgscc.ranchergovernment.com"

# -----------------------------------------------------------------------------
# Rancher Manager Configuration
# -----------------------------------------------------------------------------
rancher_version      = "2.15.2"  # Current rancher-stable chart/app version (2026-10)
#cert_manager_version = "1.15.3"
cert_manager_version = "1.21.2"  # Current supported cert-manager release line (2026-10)

# K3s version (applies to all modules: rancher-manager, observability, security)
# Leave commented to use latest stable K3s release
# Uncomment and specify version to pin K3s version across all modules
# k3s_version = "v1.36.4+k3s1"  # Example: pin to specific K3s version - certified for Rancher 2.15.x (v1.34-v1.36)

# To find available K3s versions:
#   https://github.com/k3s-io/k3s/releases

# -----------------------------------------------------------------------------
# SUSE Observability (StackState) Configuration
# -----------------------------------------------------------------------------
suse_observability_license = "YOUR_SUSE_OBSERVABILITY_LICENSE_KEY"

# Leave both blank to auto-derive as https://<hostname_*>.<subdomain>.<root_domain>
# (matching the Route53/cert-manager hostname configured above). Only set
# these explicitly if pointing at an external/pre-existing Rancher or
# Observability instance - otherwise they're easy to leave stale after a
# subdomain/hostname rename.
suse_observability_base_url = ""
suse_rancher_url            = ""
suse_observability_admin_password = "" # Leave empty to auto-generate

# -----------------------------------------------------------------------------
# SUSE Security (NeuVector) Configuration
# -----------------------------------------------------------------------------
neuvector_version = "5.6.2"  # Latest stable version (chart v2.11.2) as of 2026-10 - documentation only, not currently passed to `helm install --version`

# -----------------------------------------------------------------------------
# Optional: AMI Override (all modules)
# -----------------------------------------------------------------------------
# Leave empty to use latest SUSE Linux Enterprise Server AMI
ami_id = "" # ami-0e4ba0f9cbbb667bc (SLES 15sp7 BYOS)
